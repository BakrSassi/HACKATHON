# ================================================
# 🔐 AURA - Configuration Environnement
# ================================================

# ----------------------------------------
# Base de Données MySQL (XAMPP)
# ----------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=aura_db
DB_PORT=3306

# ----------------------------------------
# Serveur Backend
# ----------------------------------------
PORT=5003
NODE_ENV=development

# ----------------------------------------
# JWT (JSON Web Token)
# ----------------------------------------
JWT_SECRET=aura_super_secret_key_2025_bakr_sassi_cryptoshield
JWT_EXPIRES_IN=8h

# ----------------------------------------
# Session
# ----------------------------------------
SESSION_DURATION=28800000
SESSION_SECRET=aura_session_secret_key_2025

# ----------------------------------------
# Sécurité
# ----------------------------------------
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
PASSWORD_MIN_LENGTH=4

# ----------------------------------------
# 2FA (Two-Factor Authentication)
# ----------------------------------------
TFA_CODE_EXPIRATION=300000
TFA_MAX_ATTEMPTS=3

# ----------------------------------------
# 📧 Email Configuration (2FA)
# ----------------------------------------
# Provider: gmail, outlook, smtp, sendgrid
EMAIL_PROVIDER=gmail

# Votre email et App Password Gmail
# ⚠️ Pour Gmail: utilisez un App Password (16 caractères)
# Guide: EMAIL_2FA_SETUP_GUIDE.md
EMAIL_USER=noreply.aura.tn@gmail.com
EMAIL_PASSWORD=svgc mmfl reqp hdqi

# Nom de l'expéditeur affiché dans l'email
EMAIL_FROM_NAME=AURA CryptoShield

# Configuration SMTP (si EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Configuration SendGrid (si EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# ----------------------------------------
# CORS
# ----------------------------------------
CORS_ORIGIN=http://localhost:3003

# ----------------------------------------
# APIs Externes (Chatbot IA)
# ----------------------------------------
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key

# ----------------------------------------
# 🎯 AURA - APIs Dynamiques (Cahier des Charges)
# ----------------------------------------

# Blockchain RPC Endpoints
ETHEREUM_RPC_URL=https://eth.llamarpc.com
POLYGON_RPC_URL=https://polygon-rpc.com
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Explorateurs Blockchain (API Keys GRATUITES)
ETHERSCAN_API_KEY=YourApiKeyToken
POLYGONSCAN_API_KEY=YourApiKeyToken
BSCSCAN_API_KEY=YourApiKeyToken

# APIs de Données Crypto (Gratuites)
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=

# ----------------------------------------
# Paramètres App
# ----------------------------------------
APP_NAME=AURA
APP_VERSION=2.0.0
APP_DESCRIPTION=AI-Powered Financial Guardian with Blockchain Security - Dynamic Implementation
